# ─────────────────────────────────────────────────────────────
# Variables de entorno del Backend Q-Remoto
# Copia este archivo como .env y rellena los valores reales
# ─────────────────────────────────────────────────────────────

# URL de la base de datos PostgreSQL (proporcionada por Render al crear el servicio BD)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/qremoto"

# Secret para firmar los JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET="cambia_esto_por_algo_seguro_y_largo"

# URL del frontend en Vercel (sin barra al final)
# Ejemplo: https://q-remoto.vercel.app
FRONTEND_URL="https://tu-proyecto.vercel.app"

# Puerto del servidor (Render lo asigna automáticamente, no cambiar)
PORT=4000